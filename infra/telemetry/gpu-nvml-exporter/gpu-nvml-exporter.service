[Unit]
Description=gpu-nvml-exporter: NVML energy, GPM, PCIe, XID, per-process VRAM (:9836)
After=network-online.target nvidia-persistenced.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=multivac
# docker: container-name resolution for per-process VRAM.
# adm: read the kernel journal, needed only if NVML XID events are unavailable
# (journal fallback). NVML events worked unprivileged on this host; root is never required.
SupplementaryGroups=docker adm
ExecStart=/srv/bench/telemetry/.venv/bin/python /srv/bench/telemetry/gpu-nvml-exporter/gpu_nvml_exporter.py --config /srv/bench/telemetry/etc/targets.yml
Restart=always
RestartSec=5
KillMode=control-group
MemoryMax=150M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
