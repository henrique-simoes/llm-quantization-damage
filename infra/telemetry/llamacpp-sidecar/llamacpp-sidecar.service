[Unit]
Description=llamacpp-sidecar: llama.cpp /slots, /health, /props, docker logs and lifecycle exporter (:9900)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=multivac
# docker group: docker inspect / docker logs
SupplementaryGroups=docker
ExecStart=/srv/bench/telemetry/.venv/bin/python /srv/bench/telemetry/llamacpp-sidecar/llamacpp_sidecar.py --config /srv/bench/telemetry/etc/targets.yml
Restart=always
RestartSec=5
# stop the docker logs children together with the service
KillMode=control-group
MemoryMax=150M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
