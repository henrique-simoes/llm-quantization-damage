[Unit]
Description=llm-proxy - transparent instrumenting proxy in front of llama.cpp servers
Documentation=file:///srv/bench/telemetry/llm-proxy/README.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=multivac
Group=multivac
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/bench/telemetry/.venv/bin/python /srv/bench/telemetry/llm-proxy/llm_proxy.py --config /srv/bench/telemetry/etc/targets.yml
Restart=always
RestartSec=2
# The client-facing address may not exist yet at boot; Restart=always retries the bind.
StartLimitIntervalSec=0
MemoryMax=512M
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
