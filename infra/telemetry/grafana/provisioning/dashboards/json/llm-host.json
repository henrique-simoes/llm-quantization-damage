    {
      "type": "timeseries",
      "title": "Memory",
      "description": "MemTotal − MemAvailable (used), MemAvailable, and swap used (SwapTotal − SwapFree). The mmap'd model lives in page cache, so 'available' is the number that matters.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-multivac"
          },
          "expr": "node_memory_MemTotal_bytes{job=\"node\"} - node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "used",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-multivac"
          },
          "expr": "node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "available",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-multivac"
          },
          "expr": "node_memory_SwapTotal_bytes{job=\"node\"} - node_memory_SwapFree_bytes{job=\"node\"}",
          "legendFormat": "swap used",
          "refId": "C",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
