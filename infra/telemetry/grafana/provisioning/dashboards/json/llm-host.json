    {
      "type": "timeseries",
      "title": "PSI cpu / memory / io",
      "description": "rate() of node_pressure_*_seconds_total: share of wall time tasks were stalled. 'waiting' = some tasks stalled; 'stalled' = all non-idle tasks stalled (full). Linux PSI (kernel docs, Facebook).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-multivac"
          },
          "expr": "rate(node_pressure_cpu_waiting_seconds_total{job=\"node\"}[$__rate_interval])",
