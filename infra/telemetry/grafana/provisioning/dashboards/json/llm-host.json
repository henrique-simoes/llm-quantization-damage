{
  "uid": "llm-host",
  "title": "Host",
  "description": "USE view of the serving host (host RAM smaller than the mmap'd model): CPU and RAPL, memory, swap, faults, PSI, disk IO, serving containers, exporter health.",
  "tags": [
    "multivac-llm",
    "host"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "multivac LLM serving",
      "type": "dashboards",
      "tags": [
        "multivac-llm"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "llama-server restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-multivac"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(llamacpp_server_start_time_seconds[2m]) > 0",
        "step": "60s",
        "titleFormat": "llama-server restart",
        "textFormat": "{{server}} started (llamacpp_server_start_time_seconds changed)",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "CPU",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU utilisation by mode",
      "description": "1 − idle, split by mode: rate(node_cpu_seconds_total) averaged over the 12 threads.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-multivac"
          },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{job=\"node\",mode!=\"idle\"}[$__rate_interval])) / scalar(count(count by (cpu) (node_cpu_seconds_total{job=\"node\"})))",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom-multivac"
      }
    },
    {
      "type": "timeseries",
      "title": "Load average",
      "description": "node_load1/5/15 against the thread count.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-multivac"
          },
          "expr": "node_load1{job=\"node\"}",
          "legendFormat": "load1",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
