    {
      "type": "timeseries",
      "title": "Disk throughput",
      "description": "rate(node_disk_read_bytes_total) (positive) and rate(node_disk_written_bytes_total) (negative) per device. /srv/models is sda; / is sdb.",
      "targets": [
